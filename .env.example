# Copie para .env (fica fora do git) e preencha.
# Chave do Gemini (aistudio.google.com); fica só no servidor, nunca no app.
GEMINI_API_KEY=
# Assina os logins. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar o valor desconecta todo mundo (cada um entra de novo).
JWT_SECRET=
# Opcional: modelo do Gemini (padrão gemini-3.5-flash-lite)
GEMINI_MODEL=
# Opcional: caracteres de tradução online por conta por dia (padrão 200000)
DAILY_CHAR_LIMIT=
# Opcional: espaço na nuvem por conta em bytes (padrão 1 GB)
MAX_ACCOUNT_BYTES=
# true quando a API fica atrás de um proxy reverso (Caddy, Nginx, Cloudflare Tunnel): o rate limit usa o IP real
TRUST_PROXY=false
# Porta publicada no servidor (padrão 8787)
API_PORT=8787
