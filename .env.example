# Copie para .env (fica fora do git) e preencha.
# Chave do Gemini (aistudio.google.com); fica só no servidor, nunca no app.
GEMINI_API_KEY=
# Assina os logins. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar o valor desconecta todo mundo (cada um entra de novo).
JWT_SECRET=
# Opcional: modelo do Gemini (padrão gemini-3.5-flash-lite)
GEMINI_MODEL=
# Opcional: caracteres de tradução online por conta por dia (padrão 200000)
DAILY_CHAR_LIMIT=
# Opcional: espaço na nuvem por conta em bytes (padrão 1 GB)
MAX_ACCOUNT_BYTES=
# Opcional: modelos gratuitos da NVIDIA (build.nvidia.com, 40 req/min) calculam o nível dos livros e
# respondem quando o Gemini está no limite. Sem a chave, tudo vai para o Gemini.
NVIDIA_API_KEY=
NVIDIA_MODEL=moonshotai/kimi-k3
# "Esqueci minha senha": servidor de e-mail que envia o código. Ex. Gmail com senha de app:
# smtps://seu.email%40gmail.com:senha-de-app@smtp.gmail.com:465 (o @ do usuário vira %40)
SMTP_URL=
MAIL_FROM=Entrelinhas <seu.email@gmail.com>
# true quando a API fica atrás de um proxy reverso (Caddy, Nginx, Cloudflare Tunnel): o rate limit usa o IP real
TRUST_PROXY=false
# Pasta dos dados (banco e livros) no servidor; padrão ./storage. Ex.: /mnt/dados/entrelinhas
STORAGE_DIR=
# Porta publicada no servidor (padrão 8787)
API_PORT=8787
